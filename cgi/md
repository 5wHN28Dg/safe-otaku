#!/bin/sh
# MangaDex safe proxy for OpenWrt uhttpd CGI.
#
# Routes:
#   /cgi-bin/md/api/*   -> https://api.mangadex.org/*  (with contentRating[] injected)
#   /cgi-bin/md/img/*   -> https://uploads.mangadex.org/* (path-restricted)
#
# No caching on the router. Browser caches via Cache-Control headers.
# Requires uclient-fetch (installed by default on OpenWrt).

UA="MangaDexSafeView/1.0 (self-hosted home safe-mode proxy)"
API="https://api.mangadex.org"
IMG="https://uploads.mangadex.org"

case "$PATH_INFO" in
  /api/*)
    path="${PATH_INFO#/api}"

    # Strip any contentRating[] the client sent, preserve everything else.
    clean=""
    old_ifs="$IFS"
    IFS='&'
    for pair in $QUERY_STRING; do
      case "$pair" in
        contentRating%5B%5D=*|contentRating[]=*) continue ;;
      esac
      [ -n "$pair" ] || continue
      if [ -z "$clean" ]; then
        clean="$pair"
      else
        clean="$clean&$pair"
      fi
    done
    IFS="$old_ifs"

    if [ -n "$clean" ]; then
      url="${API}${path}?${clean}&contentRating%5B%5D=safe&contentRating%5B%5D=suggestive"
    else
      url="${API}${path}?contentRating%5B%5D=safe&contentRating%5B%5D=suggestive"
    fi

    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n'
    printf '\r\n'
    exec uclient-fetch -q -O - --user-agent "$UA" -T 30 "$url"
    ;;

  /img/*)
    path="${PATH_INFO#/img}"

    # Only covers and chapter data. Anything else is rejected.
    case "$path" in
      /covers/*|/data/*) ;;
      *)
        printf 'Status: 403\r\n'
        printf 'Content-Type: text/plain\r\n'
        printf '\r\n'
        printf 'Forbidden\n'
        exit 0
        ;;
    esac

    case "$path" in
      *.png) ct=image/png ;;
      *.webp) ct=image/webp ;;
      *.gif) ct=image/gif ;;
      *) ct=image/jpeg ;;
    esac

    printf 'Content-Type: %s\r\n' "$ct"
    printf 'Cache-Control: public, max-age=86400\r\n'
    printf '\r\n'
    exec uclient-fetch -q -O - --user-agent "$UA" -T 30 "${IMG}${path}"
    ;;

  *)
    printf 'Status: 404\r\n'
    printf 'Content-Type: text/plain\r\n'
    printf '\r\n'
    printf 'Not found\n'
    ;;
esac
